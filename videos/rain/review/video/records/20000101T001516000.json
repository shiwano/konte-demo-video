  "notes": [
    {
      "id": "fb-uKBQP65q",
      "time": 6.8,
      "shotId": "02",
      "address": "video:shot.02",
      "x": 0.47,
      "y": 0.32,
      "text": "By the end she's turned almost fully away from us. Keep her in three-quarter toward the glass so we still catch her eyes.",
      "displayedVariants": {
        "video:shot.02.motion": "v-7fADlkye"
      }
    },
    {
      "id": "fb-iDJp9pMd",
      "time": 16.4,
      "shotId": "05",
      "address": "video:shot.05",
      "x": 0.62,
      "y": 0.55,
      "text": "Accepting this, but could we see one where her hands actually reach the handle before the cut?",
      "displayedVariants": {
        "video:shot.05.motion": "v-UoYck1Nt"
      }
    },
    {
      "id": "fb-inG8d0ZT",
      "time": 12.3,
      "shotId": "04",
      "address": "video:shot.04",
      "text": "The umbrella sliding out is lovely. No changes.",
      "displayedVariants": {
        "video:shot.04.motion": "v-TScUmzZN"
      }
    },
    {
      "id": "fb-PWoNaGop",
      "time": 0.4,
      "shotId": "01",
      "address": "video:shot.01",
      "text": "Could the fade from black be a touch shorter? It eats the hook.",
      "displayedVariants": {
        "video:shot.01.motion": "v-FEVr63No"
      }
    },
    {
      "id": "fb-o6TAQ0vv",
      "time": 19,
      "shotId": "06",
      "address": "video:shot.06",
      "text": "Title is perfect over the umbrella.",
      "displayedVariants": {
        "video:shot.06.motion": "v-zy2o8KOE"
      }
    }
  ],
  "overallComment": "Really close. 02's turn and one more take on 05, then I think we're done.",
  "handoffId": "20000101T001514000",
  "handoffSummary": "First motion pass on all six shots, about 21 seconds. Both lines are lip-synced from the board's stems; rain runs under the whole piece and the piano enters at 03.",
  "handoffNotes": [
    {
      "address": "video:shot.01",
      "text": "Held wide, only the owner's hands and the rain moving. Opens from black over 1.2s."
    },
    {
      "address": "video:shot.02",
      "text": "Slow push in while she speaks. Check the mouth closes on 'is it?'."
    },
    {
      "address": "video:shot.04",
      "text": "The umbrella clears the top of frame at 2.9s, just before the cut."
    },
    {
      "address": "video:shot.05",
      "text": "She starts reaching for the handle at the very end — the hand-off itself is left to the cut."
    },
    {
      "address": "video:shot.06",
      "text": "Title fades in at 0.9s and holds to 3.4s before the fade to black, per your direction note."
    }
  ]
