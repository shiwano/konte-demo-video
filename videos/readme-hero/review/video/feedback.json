      },
      {
        "id": "fb-BEJSxIEs",
        "displayedVariants": {
          "video:shot.31.motion": "v-xAR95Hgu"
        },
        "displayedDefinitionHashes": {
          "video:shot.31#composition": "a484550478cf",
          "video:shot.31#stem": "82a3211bb111"
        },
        "annotation": null,
        "time": 78.96666666666667,
        "shotTime": 0.9666666666666686,
        "text": "付箋が飛んでくるのがちょっとゆっくりなので、早くしたい",
        "createdAt": "2000-01-01T00:23:55.000Z",
        "createdBy": "local"
      }
    ],
    "video:shot.33": [
      {
