        "animatic:shot.10.vo0": "v-5ZCrFAEM"
      }
    },
    {
      "id": "fb-ceqmeRpP",
      "time": 47.5,
      "shotId": "17",
      "address": "animatic:shot.17",
      "text": "液タブを端に寄せろなんて指示はしていない。前のレビューで見た画角に戻して。",
      "displayedVariants": {
        "animatic:shot.17.first": "v-vw0xx99r"
      }
    },
    {
      "id": "fb-JuJpBnp8",
      "time": 59.5,
      "shotId": "23",
      "address": "animatic:shot.23",
      "x": 0.178,
      "y": 0.978,
      "text": "この椅子はどかしたい",
      "displayedVariants": {
        "animatic:shot.23.first": "v-6tG3FeuP",
        "animatic:shot.23.vo0": "v-kH8AgPUn",
        "animatic:shot.23#composition": "v-Q7hHmPXS"
      }
    },
    {
      "id": "fb-O8I82Mke",
      "time": 58,
      "shotId": "22",
      "address": "animatic:shot.22",
      "text": "17の絵が作り直しが必要なので、ここも作り直し",
      "displayedVariants": {
        "animatic:shot.22.first": "v-3q0y2E1G"
      }
    },
    {
