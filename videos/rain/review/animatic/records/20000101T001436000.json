      "x": 0.78,
      "y": 0.2,
      "text": "This hand reads twenty years too young. Give it his age — thin knuckles, a few spots, the cardigan cuff hanging loose.",
      "displayedVariants": {
        "animatic:shot.04.first": "v-vN5msM5L"
      }
    },
    {
      "id": "fb-FNQ0Kx2n",
      "time": 5.6,
      "shotId": "02",
      "address": "animatic:shot.02",
      "text": "Her line is right. Keep the breath before it.",
      "displayedVariants": {
        "animatic:shot.02.first": "v-5kwVlnwq",
        "animatic:shot.02.line": "v-uyq7rGo1"
      }
    },
    {
      "id": "fb-st2DDvN7",
      "time": 15,
      "shotId": "05",
      "address": "animatic:shot.05",
      "x": 0.55,
      "y": 0.52,
      "text": "The handle pointing at her is what makes this. Keep it.",
