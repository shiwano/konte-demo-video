    },
    {
      "id": "fb-yWCNryVg",
      "time": 23.5,
      "shotId": "09",
      "address": "animatic:shot.09",
      "text": "僕が指定したのは07のはずだけど",
      "displayedVariants": {
        "animatic:shot.09.first": "v-z7SUPc6W",
        "animatic:shot.09.vo0": "v-dokIoqhb"
      }
    },
    {
      "id": "fb-R9hJPcm9",
      "time": 23.5,
      "shotId": "09",
      "address": "animatic:shot.09",
      "x": 0.348,
      "y": 0.678,
      "text": "指や紙も変",
      "displayedVariants": {
        "animatic:shot.09.first": "v-z7SUPc6W",
        "animatic:shot.09.vo0": "v-dokIoqhb"
      }
    },
    {
      "id": "fb-W2bDBJXz",
      "time": 47.5,
      "shotId": "17",
      "address": "animatic:shot.17",
      "text": "patch の機能で変更したいところ以外も編集されてしまっている。\npatch 使うのやめたほうがよさそう。\n前のプロンプトベースに作り直して",
      "displayedVariants": {
        "animatic:shot.17.first": "v-dOH83WQB"
      }
    },
    {
      "id": "fb-vtSxH840",
      "time": 66.5,
      "shotId": "26",
      "address": "animatic:shot.26",
      "text": "patch で関係ないところを変更されてしまっている。\n元に戻して。",
      "displayedVariants": {
        "animatic:shot.26.first": "v-IxJUovxi"
      }
    },
    {
      "id": "fb-8QAiuolt",
      "time": 71.5,
      "shotId": "28",
      "address": "animatic:shot.28",
      "text": "patch で関係ないところを編集されてしまっている。\nもとのプロンプトベースで、紙だけ消すよう生成しなおして",
      "displayedVariants": {
        "animatic:shot.28.first": "v-6PolkeXS"
      }
    }
  ],
  "handoffSummary": "五稿。08はご指名の一枚を採用として記録。09はその08の絵から「付箋をはがして読む」だけを変える編集にして、背景と立ち位置を07・08と揃えました。17はご指摘の一枚（v-tAtttWWF）の上で紙だけ中央へ、26は液タブが無地に白く光るだけ、28はタブレットを手に残して紙だけ消す編集にかけ直し。23は編集を取り消して元の絵に戻しました。",
  "handoffNotes": [
    {
      "address": "animatic:shot.09.first",
      "text": "08（ご指名の絵）を元にした編集なので、背景は白い壁でボードは右端、立ち位置もそのままです。編集の性質で少し寄りが強くなります。"
    },
    {
      "address": "animatic:shot.17.first",
      "text": "v-tAtttWWF に戻し、その上で紙を中央へ動かす編集をかけました。22は承認いただいたまま置いています（17が変わったので古い印が付きます）。"
    },
    {
      "address": "animatic:shot.23.first",
      "text": "行き過ぎた編集を取り消し、承認済みの元の絵に戻しました。椅子はそのままです。"
    },
    {
      "address": "animatic:shot.26.first",
      "text": "編集をかけ直し、液タブの画面が無地に白く光るだけにしました。"
    },
    {
      "address": "animatic:shot.28.first",
      "text": "編集をかけ直し、タブレットは手に残したまま紙だけを消しました。"
    }
  ]
}

