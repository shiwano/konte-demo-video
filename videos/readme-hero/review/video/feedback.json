          "y": 0.318
        },
        "time": 82.1,
        "shotTime": 0.5999999999999943,
        "text": "背景が30のショットとあってないので、おかしいので直したい。",
        "createdAt": "2000-01-01T00:20:07.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-DYn9OfEg",
        "displayedVariants": {
          "video:shot.33.motion": "v-vIjAVWKb",
          "video:shot.33#composition": "v-vQEFSStA"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "faba0b5b0b69",
          "video:shot.33#stem": "44294b1b885f"
        },
        "annotation": null,
        "time": 85.36666666666666,
        "shotTime": 3.86666666666666,
        "text": "ハンコはこのままでいい",
        "createdAt": "2000-01-01T00:20:07.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-nL0KII1c",
        "displayedVariants": {
          "video:shot.33.motion": "v-88ypkoaK"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "7dac99ae7a78",
          "video:shot.33#stem": "44294b1b885f"
        },
        "annotation": {
          "kind": "pin",
          "x": 0.462,
          "y": 0.333
        },
        "time": 82.96666666666667,
        "shotTime": 1.4666666666666686,
        "text": "裏返したりせず、いきなりチェックマークが出てきた。おかしい",
        "createdAt": "2000-01-01T00:21:10.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-kWRDHQr1",
        "displayedVariants": {
          "video:shot.33.motion": "v-YuYNsf3j"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "c4d833b3a725",
          "video:shot.33#stem": "44294b1b885f"
        },
        "annotation": null,
        "time": 83.76666666666667,
        "shotTime": 2.2666666666666657,
        "text": "胸に押し付けたとき、手首を返してるから、チェックマークは見えないはずなので、見えてるのはおかしい。押し付けたときにチェックマークは見えなくてもいいよ",
        "createdAt": "2000-01-01T00:21:13.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-Uki9CT72",
        "displayedVariants": {
          "video:shot.33.motion": "v-ryPNA7Rl",
          "video:shot.33#composition": "v-HHUtht3S"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "739049a09d18",
          "video:shot.33#stem": "44294b1b885f"
        },
        "annotation": {
          "kind": "pin",
          "x": 0.454,
          "y": 0.41
        },
        "time": 85.06666666666666,
        "shotTime": 3.066666666666663,
        "text": "Accepted 出るタイミングで紙吹雪とかわーっていう歓声の効果音を入れたい。composition でいい",
        "createdAt": "2000-01-01T00:23:21.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-niOAYxNS",
        "displayedVariants": {
          "video:shot.33.motion": "v-ryPNA7Rl",
          "video:shot.33.cheer": "v-d5Fr9JwW"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "f4ba191f17b0",
          "video:shot.33#stem": "bfee16d98775"
        },
        "annotation": null,
        "time": 86.43333333333334,
        "shotTime": 4.433333333333337,
        "text": "もっとリアルな紙吹雪にできない？",
        "createdAt": "2000-01-01T00:23:30.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-9QtZaxrl",
        "displayedVariants": {
          "video:shot.33.motion": "v-ryPNA7Rl",
          "video:shot.33.cheer": "v-d5Fr9JwW"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "287faa56060f",
          "video:shot.33#stem": "bfee16d98775"
        },
        "annotation": null,
        "time": 82,
        "shotTime": 0,
        "text": "画面の中央とかに紙吹雪がまとまってるので（両端にスペースがある）、画面全体に紙吹雪を飛ばしたい",
        "createdAt": "2000-01-01T00:23:55.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-Tpa14XAF",
        "displayedVariants": {
          "video:shot.33.motion": "v-ryPNA7Rl",
          "video:shot.33.cheer": "v-d5Fr9JwW",
          "video:shot.33#composition": "v-i8qX0QwA"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "b9e5159f3f5f",
          "video:shot.33#stem": "bfee16d98775"
        },
        "annotation": null,
        "time": 82,
        "shotTime": 0,
        "text": "うーん、なんか大きさは変えないでほしいかも。数も少なくなって、紙吹雪っぽくなくなってしまった。\nうまく言えないんだけど、ポップにしすぎて、逆に現実感がなくなってしまったかも",
        "createdAt": "2000-01-01T00:24:05.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-wxLFV9mU",
        "displayedVariants": {
          "video:shot.33.motion": "v-ryPNA7Rl",
          "video:shot.33.cheer": "v-d5Fr9JwW",
          "video:shot.33#composition": "v-i8qX0QwA"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "c3e92417b6df",
          "video:shot.33#stem": "bfee16d98775"
        },
        "annotation": null,
        "time": 85.63333333333334,
        "shotTime": 3.63333333333334,
        "text": "うーん、なんだろ。輪郭線が黒なのが変にみえるのかも。\nさっきほどじゃなくて、若干大きくしてもいい。",
        "createdAt": "2000-01-01T00:24:08.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-XlJeIAPg",
        "displayedVariants": {
          "video:shot.33.motion": "v-ryPNA7Rl",
          "video:shot.33.cheer": "v-d5Fr9JwW",
          "video:shot.33#composition": "v-i8qX0QwA"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "296717405917",
          "video:shot.33#stem": "bfee16d98775"
        },
        "annotation": null,
        "time": 85.1,
        "shotTime": 3.0999999999999943,
        "text": "もうちょっと輪郭線太くしてもいいかも。\nあと、影とかつけられないよね？",
        "createdAt": "2000-01-01T00:24:11.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-rJEmGwon",
        "displayedVariants": {
          "video:shot.33.motion": "v-ryPNA7Rl",
          "video:shot.33.cheer": "v-d5Fr9JwW",
          "video:shot.33#composition": "v-i8qX0QwA"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "296717405917",
          "video:shot.33#stem": "bfee16d98775"
        },
        "annotation": null,
        "time": 82,
        "shotTime": 0,
        "text": "紙吹雪が上部にあつまりすぎだからもっと散ってほしい",
        "createdAt": "2000-01-01T00:24:11.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-z2GjUNzX",
        "displayedVariants": {
          "video:shot.33.motion": "v-ryPNA7Rl",
          "video:shot.33.cheer": "v-d5Fr9JwW",
          "video:shot.33#composition": "v-i8qX0QwA"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "885f377c76c7",
          "video:shot.33#stem": "bfee16d98775"
        },
        "annotation": null,
        "time": 86,
        "shotTime": 4,
        "text": "ごめん、輪郭線と影消していいよ。\nもうちょっと画面外にも散らばる感じにしたい",
        "createdAt": "2000-01-01T00:24:14.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-fFsLriCI",
        "displayedVariants": {
          "video:shot.33.motion": "v-ryPNA7Rl",
          "video:shot.33.cheer": "v-d5Fr9JwW",
          "video:shot.33#composition": "v-i8qX0QwA"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "c137860b0d08",
          "video:shot.33#stem": "bfee16d98775"
        },
        "annotation": null,
        "time": 82,
        "shotTime": 0,
        "text": "回転速度をちょっとゆっくりにしたい",
        "createdAt": "2000-01-01T00:24:17.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-MNmOIXMk",
        "displayedVariants": {
          "video:shot.33.motion": "v-ryPNA7Rl",
          "video:shot.33.cheer": "v-d5Fr9JwW",
          "video:shot.33#composition": "v-i8qX0QwA"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "6226b7a9b0b5",
          "video:shot.33#stem": "bfee16d98775"
        },
        "annotation": null,
        "time": 86,
        "shotTime": 4,
        "text": "変な理由がわかったわ。慣性が働いてないからだ。斜めに紙吹雪がきてるのに、頂点までいったら、まっすぐ下に落ちていくから変に感じる。",
        "createdAt": "2000-01-01T00:24:20.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-PzoIFYM4",
        "displayedVariants": {
          "video:shot.33.motion": "v-ryPNA7Rl",
          "video:shot.33.cheer": "v-d5Fr9JwW",
          "video:shot.33#composition": "v-i8qX0QwA"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "dea4822dd686",
          "video:shot.33#stem": "bfee16d98775"
        },
        "annotation": null,
        "time": 85.03333333333333,
        "shotTime": 3.0333333333333314,
        "text": "減速が遅いのかな？ 横に散らばりすぎ",
        "createdAt": "2000-01-01T00:24:23.000Z",
        "createdBy": "local"
      },
      {
        "id": "fb-NIzpkmaM",
        "displayedVariants": {
          "video:shot.33.motion": "v-ryPNA7Rl",
          "video:shot.33.cheer": "v-d5Fr9JwW",
          "video:shot.33#composition": "v-i8qX0QwA"
        },
        "displayedDefinitionHashes": {
          "video:shot.33#composition": "c526a4818b45",
          "video:shot.33#stem": "bfee16d98775"
        },
        "annotation": null,
        "time": 85.06666666666666,
        "shotTime": 3.066666666666663,
        "text": "なんか気持ちよくない。横に流れるのはいいとしても、頂点までいって落ちていくときには左右に紙吹雪はまうから、そういう自然な感じにしたい",
        "createdAt": "2000-01-01T00:24:26.000Z",
        "createdBy": "local"
      }
    ],
